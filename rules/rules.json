  "usage": [
    {
      "id": "usage.accent-yellow.fill-only",
      "severity": "error",
      "description": "accent-yellow — лише заливка, маркер, смуга. Як колір тексту заборонено (1.7:1 на білому).",
      "source": "Брендбук, с. 14; контраст — похідне, відсутнє в брендбуку",
      "kind": "role",
      "role": "accent-yellow",
      "forbiddenUses": [
        "text",
        "border-text"
      ],
      "onlyAs": [
        "fill",
        "marker"
      ]
    },
    {
      "id": "usage.accent-blue.fill-only",
