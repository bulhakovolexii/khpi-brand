{
  "name": "khpi-brand",
  "version": "0.1.0",
  "description": "Брендовий пакет НТУ «ХПІ»: токени DTCG, правила як дані, адаптери під стеки та brand-check.",
  "type": "module",
  "license": "MIT",
  "private": true,
  "bin": {
    "khpi-brand": "check/cli.js"
  },
  "files": [
    "dist",
    "tokens",
    "rules",
    "assets",
    "skill",
    "check",
    "lib",
    "DESIGN.md",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node build.config.js && node scripts/build-design-md.js",
    "test": "node --test --test-timeout=600000 \"test/*.test.js\"",
    "check": "node check/cli.js check",
    "lint:design": "npx --yes @google/design.md lint DESIGN.md",
    "check:examples": "node scripts/build-examples.js --shots",
    "fonts": "node scripts/fetch-fonts.js"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "style-dictionary": "^5.8.0"
  },
  "optionalDependencies": {
    "playwright": "^1.50.0"
  }
}
